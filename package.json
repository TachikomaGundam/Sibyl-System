{
  "name": "sibyl-system",
  "version": "1.4.0",
  "license": "MIT",
  "type": "module",
  "description": "Sibyl-System: democratic-centralism review chamber (one conclusion, one voice) + fail-closed council voting + dynamic swarm plugin for OpenCode",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "llm",
    "council",
    "code-review",
    "verdict",
    "swarm"
  ],
  "homepage": "https://github.com/TachikomaGundam/Sibyl-System",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/TachikomaGundam/Sibyl-System.git"
  },
  "bugs": {
    "url": "https://github.com/TachikomaGundam/Sibyl-System/issues"
  },
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --outfile=dist/index.js && esbuild src/cli.ts --bundle --format=esm --platform=node --banner:js='#!/usr/bin/env node' --outfile=dist/cli.js",
    "test": "node --import ./tools/register-ts.mjs --test test/*.test.ts",
    "coverage": "node --import ./tools/register-ts.mjs --test --experimental-test-coverage \"--test-coverage-include=src/**\" --test-coverage-lines=55 --test-coverage-branches=80 --test-coverage-functions=90 test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.19.4",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "typescript": "^5"
  },
  "bin": {
    "sibyl-chamber": "./dist/cli.js"
  },
  "overrides": {
    "toml": "5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
