#!/usr/bin/env bash
# release-guard pre-push hook (installed from scripts/git-hooks/pre-push into
# .git/hooks/pre-push — re-copy after fresh clones; hooks are not cloned).
#
# Law (human-approved 2026-09-30, dual-vehicle collision of npm 0.2.6):
#   pushing a NEW or UPDATED refs/tags/v* requires the packet receipt INSIDE
#   the pushed tag object AND a matching release lease. Deletions always pass
#   (retiring a bad tag must never need paperwork). Non-release refs pass.
#
# W4 (2026-10-04, root cause of the fourth red): the receipt and the package
#   version are read ONLY from the pushed tag's object body via
#   `git show <oid>:<path>`. Reading the working tree is forbidden: a worktree
#   read blesses a tag that does not carry its own paperwork — the exact
#   failure "receipt on disk, absent inside the tag". The tag object IS the
#   release; if the fact is not in it, the fact does not exist for this gate.
#
# Receipt  : docs/release/<version>.md inside the tag object
#            (tree-relative dir override: SIBYL_RELEASE_RECEIPT_DIR)
#            must contain a line starting with:  gate: PASS
# Version  : package.json "version" inside the tag object must equal the tag
#            name minus the leading "v" — the ghost-version class, killed by
#            comparing tag-body facts against the ref being pushed.
# Lease    : ~/.config/sibyl/release-lease.json  (override: SIBYL_RELEASE_LEASE)
#            must name "version":"<version>"
#            (operator-local coordination state lives OUTSIDE git by design;
#            it is not release content and has no tag-object form.)
# Fail-open ONLY on ref lines we do not police. Every refusal names what it
# looked for and where.

remote="$1"
url="$2"

LEASE_FILE="${SIBYL_RELEASE_LEASE:-$HOME/.config/sibyl/release-lease.json}"
RECEIPT_SUBDIR="${SIBYL_RELEASE_RECEIPT_DIR:-docs/release}"

block() { printf 'release-guard: %s\n' "$*" >&2; exit 1; }

# Read a path from the pushed object's body. Any failure (missing path, bad
# object, non-repo cwd) is a block — fail-closed is the whole point of W4.
obj_body() { git show "$1:$2" 2>/dev/null; }

# A line is policed under EVERY release name it touches: the pushed (local)
# ref and, for rename pushes (`git push origin refs/tags/x:refs/tags/v1.2.3`),
# the remote ref too — the remote tag being created/updated is the artifact
# the wheel governs, whichever local name carried it.
police_name() { # $1=ref name to police, $2=pushed oid
  local ref="$1" oid="$2" ver receipt_path receipt pkg pkg_ver lease_ver
  case "$ref" in refs/tags/v*) ;; *) return 0 ;; esac
  # zero oid on the PUSHED side = deletion of this name — always allowed
  # (a rename that CREATES a remote tag carries a nonzero pushed oid and a
  # zero remote oid — that creation is policed under the remote name)
  [ "$oid" = "0000000000000000000000000000000000000000" ] && return 0
  ver="${ref#refs/tags/}"
  receipt_path="$RECEIPT_SUBDIR/$ver.md"
  receipt="$(obj_body "$oid" "$receipt_path")" \
    || block "tag $ver -> $remote: receipt $receipt_path is NOT in the pushed object (W4: worktree reads are forbidden — the tag must carry its own paperwork; git add the receipt into the released commit)"
  printf '%s\n' "$receipt" | grep -q '^gate: PASS$' \
    || block "receipt $receipt_path inside tag $ver lacks an exact 'gate: PASS' line — the gate decides, the receipt only records"
  pkg="$(obj_body "$oid" "package.json")" \
    || block "tag $ver -> $remote: package.json is not readable from the pushed object — cannot check the version against the tag name"
  pkg_ver="$(printf '%s' "$pkg" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
  [ "$pkg_ver" = "${ver#v}" ] \
    || block "tag $ver carries package.json version \"$pkg_ver\" inside its own object — ghost-version class: the in-tag version must equal the tag name"
  [ -f "$LEASE_FILE" ] || block "no release lease at $LEASE_FILE (scripts/release-lease.sh acquire $ver <who>)"
  # EXACT string compare on the lease value: dots in a version are data, not
  # regex — an unescaped grep let "v9x9x9" authorize "v9.9.9".
  lease_ver="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$LEASE_FILE" | head -n 1)"
  [ "$lease_ver" = "$ver" ] \
    || block "lease at $LEASE_FILE does not name $ver (found \"$lease_ver\") — is another seat holding the wheel?"
}

while read -r local_ref local_oid remote_ref remote_oid; do
  police_name "$local_ref" "$local_oid"
  # rename pushes carry a DIFFERENT remote name; police the remote identity too
  # (a plain same-name line double-checks the same facts — idempotent).
  police_name "$remote_ref" "$local_oid"
done

exit 0
