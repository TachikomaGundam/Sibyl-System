# Operator-local device config — NEVER part of the shipped package.
# Excluded mechanically: package.json "files" allowlist is dist/, README.md,
# LICENSE; ship.sh gate 5a fails any packed surface beyond that allowlist.
# Carried here per the standing release principle (operator, 2026-10-01):
# device model ids live on operator machines, not in the portable package.
# Value preserved from the device-side default (plugin/config.ts
# DEFAULT_TRANSLATE_MODEL) — de-pinning keeps the capability, drops the pin.
HISTORIAN_TRANSLATE_MODEL=qwen3.7-plus
